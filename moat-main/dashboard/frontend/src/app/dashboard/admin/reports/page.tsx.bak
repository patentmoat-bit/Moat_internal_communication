"use client";

import { useState, useEffect } from "react";
import { 
  FileText, ArrowLeft, Loader2, Download, Printer, ShieldCheck, 
  Users, Activity, Lock, Ban, Clock, AlertTriangle 
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import Link from "next/link";

export default function AdminReportsPage() {
  const [step, setStep] = useState(0); // 0: Input, 1: Loading, 2: Report
  const [reportData, setReportData] = useState<any | null>(null);
  const [progressMsg, setProgressMsg] = useState("");
  const [reportName, setReportName] = useState("System Health & Security Audit");

  const generateAdminReport = async () => {
    setStep(1);
    setProgressMsg("Aggregating IAM telemetry...");

    setTimeout(() => setProgressMsg("Analyzing security perimeters & firewalls..."), 800);
    setTimeout(() => setProgressMsg("Compiling workflow and user activity logs..."), 1600);

    try {
      // Fetch data from multiple admin endpoints
      const [ccRes, secRes] = await Promise.all([
        fetch("/api/dashboard/admin/control-center"),
        fetch("/api/admin/security/metrics")
      ]);
      
      const ccData = await ccRes.json();
      const secData = await secRes.json();

      setReportData({
        title: reportName || "Admin System Health & Security Audit",
        generatedAt: new Date().toISOString(),
        users: ccData.data?.kpis?.users || { total: 0, active: 0, inactive: 0 },
        workflow: ccData.data?.kpis?.workflowStages || {},
        security: secData.metrics || {},
        alerts: ccData.data?.securityAlerts || [],
        attention: ccData.data?.attentionRequired || []
      });

      setTimeout(() => setStep(2), 2400);
    } catch (e) {
      console.error(e);
      alert("Failed to generate admin report.");
      setStep(0);
    }
  };

  const handlePrint = () => window.print();

  const handleDownloadJSON = () => {
    if (!reportData) return;
    const blob = new Blob([JSON.stringify(reportData, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `Admin_Report_${new Date().toISOString().split("T")[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="space-y-6 max-w-5xl mx-auto pb-20 p-6">
      <style jsx global>{`
        @media print {
          body * { visibility: hidden; }
          #print-admin-report, #print-admin-report * { visibility: visible; }
          #print-admin-report {
            position: absolute; left: 0; top: 0; width: 100%; padding: 0;
            background: white; color: black !important;
          }
          .no-print { display: none !important; }
        }
      `}</style>

      <div className="no-print">
        <div className="flex items-center gap-3">
            <Link href="/dashboard/admin">
                <Button variant="ghost" size="icon" className="rounded-full border border-border/50">
                    <ArrowLeft className="h-4 w-4" />
                </Button>
            </Link>
            <div>
                <h1 className="text-2xl font-bold tracking-tight flex items-center gap-2">
                <FileText className="h-6 w-6 text-[#c9a84c]" />
                Executive Admin Reports
                </h1>
                <p className="text-xs text-muted-foreground mt-0.5">
                Generate holistic system reports covering user access, security incidents, and workflow queues.
                </p>
            </div>
        </div>
      </div>

      <Separator className="no-print" />

      {step === 0 && (
        <Card className="border-border/60 shadow-lg no-print max-w-2xl mx-auto mt-10">
          <CardHeader className="bg-muted/30 border-b border-border/50">
            <CardTitle className="text-base font-bold flex items-center gap-2">
                <ShieldCheck className="h-5 w-5 text-[#c9a84c]" /> System Telemetry Audit
            </CardTitle>
            <CardDescription className="text-xs">Compile real-time IAM, Security, and Database telemetry into an immutable report.</CardDescription>
          </CardHeader>
          <CardContent className="space-y-6 pt-6">
            <div className="space-y-2">
                <label className="text-xs font-bold text-foreground">Report Title</label>
                <input
                    type="text"
                    value={reportName}
                    onChange={(e) => setReportName(e.target.value)}
                    className="w-full px-3 py-2 text-sm rounded-lg border border-border bg-background focus:outline-none focus:border-[#c9a84c]"
                />
            </div>
            
            <div className="bg-muted/20 border border-border rounded-lg p-4 space-y-3">
                <h4 className="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-2">Metrics Included:</h4>
                <div className="grid grid-cols-2 gap-3 text-sm">
                    <div className="flex items-center gap-2"><Users className="h-4 w-4 text-emerald-500"/> User Activity & Sessions</div>
                    <div className="flex items-center gap-2"><Lock className="h-4 w-4 text-red-500"/> Authentication Failures</div>
                    <div className="flex items-center gap-2"><Activity className="h-4 w-4 text-blue-500"/> Workflow Queues</div>
                    <div className="flex items-center gap-2"><Ban className="h-4 w-4 text-rose-500"/> WAF & Rate Limit Drops</div>
                </div>
            </div>

            <Button onClick={generateAdminReport} className="w-full font-bold bg-[#c9a84c] text-black hover:bg-[#b59540]">
              Compile Executive Report
            </Button>
          </CardContent>
        </Card>
      )}

      {step === 1 && (
        <div className="flex flex-col items-center justify-center py-32 gap-4 text-center no-print">
          <Loader2 className="h-12 w-12 animate-spin text-[#c9a84c]" />
          <div>
            <h3 className="text-base font-bold text-foreground">Aggregating System Telemetry</h3>
            <p className="text-xs text-muted-foreground mt-2 font-mono">{progressMsg}</p>
          </div>
        </div>
      )}

      {step === 2 && reportData && (
        <div className="space-y-6 animate-in fade-in duration-500">
          <div className="no-print flex justify-end gap-2">
            <Button size="sm" variant="outline" onClick={() => setStep(0)}>
              <ArrowLeft className="h-3.5 w-3.5 mr-1" /> New Report
            </Button>
            <Button size="sm" variant="outline" onClick={handleDownloadJSON}>
              <Download className="h-3.5 w-3.5 mr-1" /> JSON
            </Button>
            <Button size="sm" onClick={handlePrint} className="bg-[#c9a84c] text-black hover:bg-[#b59540]">
              <Printer className="h-3.5 w-3.5 mr-1" /> Print / Export PDF
            </Button>
          </div>

          <Card id="print-admin-report" className="border-border shadow-2xl bg-card">
            <CardHeader className="border-b border-border/50 pb-6">
                <div className="flex justify-between items-start mb-4">
                    <div>
                        <h1 className="text-2xl font-black text-foreground">{reportData.title}</h1>
                        <p className="text-sm text-muted-foreground mt-1 flex items-center gap-2">
                            <Clock className="h-4 w-4" /> Generated: {new Date(reportData.generatedAt).toLocaleString()}
                        </p>
                    </div>
                    <Badge variant="outline" className="border-[#c9a84c]/40 text-[#c9a84c] uppercase tracking-widest text-[10px] px-3 py-1 bg-[#c9a84c]/5">
                        CONFIDENTIAL
                    </Badge>
                </div>
            </CardHeader>

            <CardContent className="p-8 space-y-10">
                
                {/* 1. Identity & Access Management */}
                <section>
                    <h3 className="text-lg font-bold border-b border-border/40 pb-2 mb-4 text-foreground flex items-center gap-2">
                        <Users className="h-5 w-5 text-emerald-500" /> Identity & Access Management
                    </h3>
                    <div className="grid grid-cols-3 gap-6">
                        <div className="bg-muted/20 p-4 rounded-xl border border-border">
                            <div className="text-sm text-muted-foreground font-semibold">Total Provisioned Users</div>
                            <div className="text-3xl font-black mt-1">{reportData.users?.total || 0}</div>
                        </div>
                        <div className="bg-emerald-500/5 p-4 rounded-xl border border-emerald-500/20">
                            <div className="text-sm text-emerald-600 dark:text-emerald-400 font-semibold">Active Sessions (30d)</div>
                            <div className="text-3xl font-black mt-1 text-emerald-600 dark:text-emerald-400">{reportData.users?.active || 0}</div>
                        </div>
                        <div className="bg-muted/20 p-4 rounded-xl border border-border">
                            <div className="text-sm text-muted-foreground font-semibold">Inactive Accounts</div>
                            <div className="text-3xl font-black mt-1">{reportData.users?.inactive || 0}</div>
                        </div>
                    </div>
                </section>

                {/* 2. Security Threat Landscape */}
                <section>
                    <h3 className="text-lg font-bold border-b border-border/40 pb-2 mb-4 text-foreground flex items-center gap-2">
                        <ShieldCheck className="h-5 w-5 text-red-500" /> Security Perimeter Metrics (24h)
                    </h3>
                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div className="p-4 rounded-xl border border-red-500/20 bg-red-500/5 text-center">
                            <div className="text-3xl font-black text-red-500">{reportData.security?.failedLoginsToday || 0}</div>
                            <div className="text-[11px] uppercase tracking-wider text-red-500/80 font-bold mt-1">Failed Logins</div>
                        </div>
                        <div className="p-4 rounded-xl border border-orange-500/20 bg-orange-500/5 text-center">
                            <div className="text-3xl font-black text-orange-500">{reportData.security?.lockedAccounts || 0}</div>
                            <div className="text-[11px] uppercase tracking-wider text-orange-500/80 font-bold mt-1">Locked Accounts</div>
                        </div>
                        <div className="p-4 rounded-xl border border-rose-500/20 bg-rose-500/5 text-center">
                            <div className="text-3xl font-black text-rose-500">{reportData.security?.blockedIps || 0}</div>
                            <div className="text-[11px] uppercase tracking-wider text-rose-500/80 font-bold mt-1">Blocked IPs</div>
                        </div>
                        <div className="p-4 rounded-xl border border-amber-500/20 bg-amber-500/5 text-center">
                            <div className="text-3xl font-black text-amber-500">{reportData.security?.rateLimitedRequests || 0}</div>
                            <div className="text-[11px] uppercase tracking-wider text-amber-500/80 font-bold mt-1">WAF Rejections</div>
                        </div>
                    </div>
                </section>

                {/* 3. Actionable Intelligence */}
                {(reportData.attention?.length > 0 || reportData.alerts?.length > 0) && (
                    <section>
                        <h3 className="text-lg font-bold border-b border-border/40 pb-2 mb-4 text-foreground flex items-center gap-2">
                            <AlertTriangle className="h-5 w-5 text-amber-500" /> Administrative Anomalies
                        </h3>
                        <div className="space-y-3">
                            {reportData.attention?.map((item: any) => (
                                <div key={item.id} className="flex items-start gap-3 p-3 rounded-lg bg-muted/30 border border-border/50 text-sm">
                                    <Badge variant="outline" className={item.level === 'CRITICAL' ? 'border-red-500 text-red-500' : 'border-amber-500 text-amber-500'}>
                                        {item.level}
                                    </Badge>
                                    <span className="font-medium">{item.title}</span>
                                </div>
                            ))}
                            {reportData.alerts?.map((item: any, i: number) => (
                                <div key={i} className="flex items-start gap-3 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-sm text-red-600 dark:text-red-400 font-medium">
                                    <ShieldCheck className="h-4 w-4 shrink-0 mt-0.5" />
                                    {item.message}
                                </div>
                            ))}
                        </div>
                    </section>
                )}

                {/* 4. Workflow State */}
                <section>
                    <h3 className="text-lg font-bold border-b border-border/40 pb-2 mb-4 text-foreground flex items-center gap-2">
                        <Activity className="h-5 w-5 text-blue-500" /> Platform Workflow Utilization
                    </h3>
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        {Object.entries(reportData.workflow || {}).map(([stage, count]: [string, any]) => (
                            <div key={stage} className="p-3 bg-muted/20 border border-border rounded-lg flex flex-col items-center">
                                <span className="text-xl font-bold">{count}</span>
                                <span className="text-[10px] text-muted-foreground uppercase tracking-wider text-center mt-1">
                                    {stage.replace(/([A-Z])/g, ' $1').trim()}
                                </span>
                            </div>
                        ))}
                    </div>
                </section>

                <div className="mt-12 text-center text-[10px] text-muted-foreground font-mono pt-4 border-t border-border/30">
                    END OF REPORT • GENERATED BY MOAT ENTERPRISE ADMIN ENGINE • {reportData.generatedAt}
                </div>

            </CardContent>
          </Card>
        </div>
      )}
    </div>
  );
}
