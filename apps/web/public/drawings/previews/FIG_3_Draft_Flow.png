<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="800" height="1000">
  <rect width="800" height="1000" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <!-- Margins: 37 CFR 1.84 (Top 1.0", Left 1.0", Bottom 0.625", Right 0.625") -->
  <rect x="72" y="72" width="673" height="873" fill="none" stroke="#d0d0d0" stroke-width="1" stroke-dasharray="4 4"/>
  
  <text x="400" y="960" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#000000">FIG. 3</text>
  <text x="400" y="100" font-family="Arial, sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#000000">Dynamic Threshold Flowchart</text>
  
  <!-- Diagram blocks -->
  <rect x="150" y="200" width="220" height="120" fill="none" stroke="#000000" stroke-width="2"/>
  <text x="260" y="260" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#000000">Cloud Coordinator</text>
  <line x1="260" y1="200" x2="260" y2="160" stroke="#000000" stroke-width="1.5"/>
  <circle cx="260" cy="160" r="3" fill="#000000"/>
  <text x="270" y="155" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#000000">102</text>
  
  <line x1="370" y1="260" x2="470" y2="260" stroke="#000000" stroke-width="2"/>
  <polygon points="465,255 475,260 465,265" fill="#000000"/>
  
  <rect x="480" y="200" width="200" height="120" fill="none" stroke="#000000" stroke-width="2"/>
  <text x="580" y="260" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#000000">Gateway Controller</text>
  <line x1="580" y1="200" x2="580" y2="160" stroke="#000000" stroke-width="1.5"/>
  <circle cx="580" cy="160" r="3" fill="#000000"/>
  <text x="590" y="155" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#000000">104</text>
  
  <!-- Downward routing -->
  <line x1="580" y1="320" x2="580" y2="420" stroke="#000000" stroke-width="2"/>
  <polygon points="575,415 580,425 585,415" fill="#000000"/>
  
  <rect x="250" y="430" width="350" height="140" fill="none" stroke="#000000" stroke-width="2"/>
  <text x="425" y="490" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#000000">Power Allocation Matrix</text>
  <text x="425" y="520" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#333333">(Dynamic Weight Router)</text>
  <line x1="425" y1="430" x2="425" y2="390" stroke="#000000" stroke-width="1.5"/>
  <circle cx="425" cy="390" r="3" fill="#000000"/>
  <text x="435" y="385" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#000000">106</text>
  
  <!-- Secondary Nodes -->
  <rect x="180" y="650" width="180" height="90" fill="none" stroke="#000000" stroke-width="2"/>
  <text x="270" y="700" font-family="Arial, sans-serif" font-size="13" text-anchor="middle" fill="#000000">HVAC Node 108</text>
  
  <rect x="450" y="650" width="180" height="90" fill="none" stroke="#000000" stroke-width="2"/>
  <text x="540" y="700" font-family="Arial, sans-serif" font-size="13" text-anchor="middle" fill="#000000">HVAC Node 110</text>
  
  <line x1="350" y1="570" x2="270" y2="650" stroke="#000000" stroke-width="1.5"/>
  <line x1="500" y1="570" x2="540" y2="650" stroke="#000000" stroke-width="1.5"/>
</svg>
