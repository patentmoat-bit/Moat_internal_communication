# --- Runtime ----------------------------------------------------------------
MOAT_ENV=development            # development | staging | production
MOAT_LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Points at PgBouncer in every environment. The application never holds a
# direct Postgres connection; migrations do, through MOAT_MIGRATION_DSN.
MOAT_DATABASE_DSN=postgresql+psycopg://moat_app:dev_app_pw@localhost:6432/moat
MOAT_MIGRATION_DSN=postgresql+psycopg://moat_owner:dev_owner_pw@localhost:5433/moat

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes. Rotating this invalidates every live session.
MOAT_SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
MOAT_SESSION_TTL_HOURS=12
MOAT_COOKIE_SECURE=false        # must be true anywhere that is not localhost

# --- Authentication ---------------------------------------------------------
# oidc  -> Keycloak authorization-code flow with PKCE (the production path)
# dev   -> email + password held locally. Refuses to start when MOAT_ENV is
#          production, and exists only so the stack is runnable without an
#          identity provider configured.
MOAT_AUTH_MODE=dev

MOAT_OIDC_ISSUER=http://localhost:8080/realms/moat
MOAT_OIDC_CLIENT_ID=moat-web
MOAT_OIDC_CLIENT_SECRET=
MOAT_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# --- Web --------------------------------------------------------------------
MOAT_WEB_ORIGIN=http://localhost:3000

# --- Search / objects / workflow (wired in later phases) --------------------
MOAT_OPENSEARCH_URL=http://localhost:9200

# Static embedding model loaded in-process. Empty disables vector search and
# retrieval degrades to BM25 -- every stored result records which ran.
MOAT_EMBEDDING_MODEL=minishlab/potion-base-8M

MOAT_S3_ENDPOINT=http://localhost:8333
MOAT_S3_ACCESS_KEY=moat-dev
MOAT_S3_SECRET_KEY=moat-dev-secret
MOAT_S3_BUCKET=moat-documents
MOAT_UPLOAD_MAX_BYTES=104857600

MOAT_TEMPORAL_ADDRESS=localhost:7233
MOAT_TEMPORAL_NAMESPACE=default

# Document conversion service (DOCX -> PDF). Isolated on purpose.
MOAT_GOTENBERG_URL=http://localhost:3002

# Login attempts per five minutes. Tight per account (password guessing),
# loose per address (an office shares one NAT gateway). Production
# refuses to start with the account limit above 10.
MOAT_LOGIN_MAX_PER_ACCOUNT=10
MOAT_LOGIN_MAX_PER_ADDRESS=120
