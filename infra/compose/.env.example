# Local development only. Never reuse these values anywhere else.
# Production credentials come from OpenBao via External Secrets (design doc §2).

COMPOSE_PROJECT_NAME=moat

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_pw
POSTGRES_PORT=5433

# Application role. Deliberately NOT the database owner and NOT BYPASSRLS,
# so row-level security actually applies during development (design doc §5).
MOAT_DB=moat
MOAT_DB_OWNER=moat_owner
MOAT_DB_OWNER_PASSWORD=dev_owner_pw
MOAT_DB_APP_USER=moat_app
MOAT_DB_APP_PASSWORD=dev_app_pw

# --- PgBouncer --------------------------------------------------------------
PGBOUNCER_PORT=6432

# --- Identity ---------------------------------------------------------------
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dev_keycloak_pw
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_admin_pw
KEYCLOAK_PORT=8080

# --- Search -----------------------------------------------------------------
OPENSEARCH_PORT=9200
# Required by OpenSearch even when the security plugin is disabled.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dev_Opensearch_pw1!

# --- Cache ------------------------------------------------------------------
VALKEY_PORT=6380

# --- Objects ----------------------------------------------------------------
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333

# --- Workflow ---------------------------------------------------------------
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Observability ----------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=dev_grafana_pw

# --- Export -----------------------------------------------------------------
GOTENBERG_PORT=3002
