# Copy this file to .env.local (development) or configure these as real
# environment variables in your deployment platform (production). Never
# commit actual secret values — only this template with placeholders.

# ── Core app / API ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose via a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Required. There is no hardcoded fallback — the app fails closed (throws)
# if this is unset, so a real, random secret must be provided in every
# environment.
JWT_SECRET_KEY=

# ── MFA ──────────────────────────────────────────────────────────────────
# Required. Encrypts stored TOTP secrets (src/services/auth/EncryptionService.ts).
# There is no hardcoded fallback — the app fails closed if this is unset.
MFA_ENCRYPTION_KEY=

# ── Microsoft Graph / Azure AD (system email sending) ───────────────────────
# Used by src/lib/events/handlers.ts and the Settings > Email page
# (src/app/api/settings/email) to send mail via Microsoft Graph.
# These override the placeholder values checked into
# src/app/api/settings/email/email_config.json.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
